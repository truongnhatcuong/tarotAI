{
  "name": "tarot-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "description": "Vietnamese Tarot with 78 cards, GSAP and server-side AI",
  "scripts": {
    "prepare:images": "node scripts/prepare-images.mjs",
    "verify:artwork": "node scripts/verify-artwork.mjs",
    "postinstall": "npm run prepare:images",
    "predev": "npm run prepare:images",
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "npm run prepare:images",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 2222",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/register-test-loader.mjs --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:artwork": "npm run verify:artwork && playwright test --config playwright.artwork.config.ts"
  },
  "dependencies": {
    "@cometpisces/tarot-kit-images": "^0.2.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@react-three/postprocessing": "3.1.3",
    "gsap": "3.15.0",
    "lucide-react": "0.540.0",
    "next": "16.2.10",
    "postprocessing": "6.39.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.184.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "4.2.4",
    "@types/node": "22.19.21",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.184.0",
    "postcss": "8.5.12",
    "tailwindcss": "4.2.4",
    "typescript": "5.9.3"
  }
}

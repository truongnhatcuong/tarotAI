AI_API_KEY=
# Base URL (".../v1" -> /chat/completions is appended), or a full
# ".../chat/completions" or ".../responses" endpoint.
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Legacy OPENAI_API_KEY / OPENAI_MODEL / OPENAI_BASE_URL are still read as fallbacks.
